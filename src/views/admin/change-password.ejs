<%- include('partials/header', { pageTitle: 'Đổi mật khẩu', active: 'change-password' }) %>
<div class="admin-topbar"><h2>Đổi mật khẩu</h2></div>
<div class="card" style="max-width:420px;">
  <% error.forEach(function(e) { %><div class="alert error"><%= e %></div><% }) %>
  <% success.forEach(function(s) { %><div class="alert success"><%= s %></div><% }) %>
  <form method="POST" action="/admin/change-password">
    <div class="form-group">
      <label>Mật khẩu hiện tại</label>
      <input type="password" name="currentPassword" required>
    </div>
    <div class="form-group">
      <label>Mật khẩu mới (tối thiểu 8 ký tự)</label>
      <input type="password" name="newPassword" minlength="8" required>
    </div>
    <div class="form-group">
      <label>Xác nhận mật khẩu mới</label>
      <input type="password" name="confirmPassword" minlength="8" required>
    </div>
    <button class="btn" type="submit">Cập nhật</button>
  </form>
</div>
<%- include('partials/footer') %>
