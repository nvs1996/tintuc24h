<%- include('../partials/header', { pageTitle: 'Danh mục', active: 'categories' }) %>
<div class="admin-topbar">
  <h2>Danh mục</h2>
  <a class="btn" href="/admin/categories/new">+ Thêm danh mục</a>
</div>
<% error.forEach(function(e) { %><div class="alert error"><%= e %></div><% }) %>
<% success.forEach(function(s) { %><div class="alert success"><%= s %></div><% }) %>
<div class="card">
  <table>
    <thead><tr><th>STT</th><th>Tiêu đề</th><th>Slug</th><th>Ngày tạo</th><th></th></tr></thead>
    <tbody>
      <% categories.forEach(function(cat, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= cat.title %></td>
          <td><%= cat.slug %></td>
          <td><%= new Date(cat.createdAt).toLocaleDateString('vi-VN') %></td>
          <td>
            <a href="/admin/categories/<%= cat._id %>/edit">Sửa</a>
            &nbsp;|&nbsp;
            <form method="POST" action="/admin/categories/<%= cat._id %>/delete" style="display:inline" onsubmit="return confirm('Xóa danh mục này?');">
              <button type="submit" style="background:none;border:none;color:#b91c1c;cursor:pointer;padding:0;font-size:14px;">Xóa</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!categories.length) { %><tr><td colspan="5">Chưa có danh mục nào.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
