# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Leave MONGODB_URI empty during local dev to auto-start an in-memory MongoDB
# (data resets every restart). Set a real connection string for anything that
# needs to persist (local mongod, Docker, or MongoDB Atlas).
MONGODB_URI=

# Used only by `npm run seed` to create the first admin account.
# The seed script refuses to run if an admin already exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
